{
  "name": "dsh-doc-convert",
  "version": "0.1.0",
  "type": "module",
  "description": "Document conversion plugin: Office, PDF, Markdown, HTML, TXT and CSV/XLSX with a sidebar panel and a convert_document tool.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsy334/dsh-doc-convert.git"
  },
  "homepage": "https://github.com/zsy334/dsh-doc-convert#readme",
  "bugs": {
    "url": "https://github.com/zsy334/dsh-doc-convert/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "document-conversion",
    "pdf",
    "docx",
    "markdown",
    "html",
    "xlsx",
    "csv",
    "pptx"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/libreoffice-kit": "0.2.3",
    "docx": "^9.15.1",
    "mammoth": "^1.13.0",
    "markdown-it": "^14.1.0",
    "node-html-markdown": "^1.3.0",
    "node-html-parser": "^9.0.6",
    "pdfjs-dist": "4.10.38",
    "write-excel-file": "^4.1.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
